{
  "name": "dawnbreakers",
  "version": "0.1.0",
  "description": "A 2.5D web RPG based on The Dawn-Breakers",
  "scripts": {
    "dev": "vite",
    "dev:server": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "dev:starfield": "npm run skyrewind:cpp:run",
    "build": "tsc --noEmit && vite build",
    "demo:build": "tsc --noEmit && vite build --outDir dist-demo",
    "demo:serve": "vite preview --host 0.0.0.0 --port 4173 --strictPort --outDir dist-demo",
    "lint": "npm run lint:eslint && npm run lint:localization && npm run lint:dialogues && npm run lint:content",
    "lint:eslint": "eslint 'src/**/*.ts'",
    "lint:localization": "node scripts/lint-localization.mjs",
    "lint:dialogues": "node scripts/lint-dialogues.mjs",
    "lint:content": "node scripts/lint-content.mjs",
    "lint:duplicates": "jscpd --config .jscpd.json src scripts",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "skyrewind:catalog": "node scripts/generate-hipparcos-catalog.mjs",
    "skyrewind:cpp:configure": "cmake -S native/skyrewind-cpp -B native/skyrewind-cpp/build",
    "skyrewind:cpp:build": "npm run skyrewind:cpp:configure && cmake --build native/skyrewind-cpp/build",
    "skyrewind:cpp:check": "npm run skyrewind:catalog && npm run skyrewind:cpp:build && native/skyrewind-cpp/build/skyrewind_cpp --check && native/skyrewind-cpp/build/skyrewind_cpp --shader-check",
    "skyrewind:cpp:run": "npm run skyrewind:catalog && npm run skyrewind:cpp:build && native/skyrewind-cpp/build/skyrewind_cpp",
    "smoke": "node scripts/smoke-scenes.mjs",
    "gallery": "node scripts/art-gallery.mjs",
    "render:music": "node scripts/render-music.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "phaser": "^3.90.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/three": "^0.184.1",
    "eslint": "^10.4.1",
    "jscpd": "^4.2.4",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^5.4.21"
  }
}
